{
  "name": "ghostty-studio",
  "private": true,
  "version": "0.4.0",
  "description": "A local visual editor for the Ghostty config you actually use.",
  "license": "MIT",
  "author": "SteinsHead",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SteinsHead/ghostty-studio.git"
  },
  "homepage": "https://steinshead.github.io/ghostty-studio/",
  "bugs": "https://github.com/SteinsHead/ghostty-studio/issues",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:web": "pnpm build && pnpm test && pnpm site:build",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "check": "pnpm check:web && pnpm check:rust",
    "build:app": "bash scripts/build-macos-app.sh",
    "package:macos-local": "bash scripts/package-macos-local.sh",
    "site:build": "node scripts/build-site.mjs",
    "tauri": "tauri"
  },
  "engines": {
    "node": ">=22.11 <23",
    "pnpm": ">=10 <11"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "25.0.1",
    "typescript": "7.0.2",
    "vite": "6.4.3",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@10.8.1"
}
