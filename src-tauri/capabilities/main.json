{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Narrow IPC access for the trusted bundled Ghostty Studio UI.",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "allow-probe-environment",
    "allow-load-runtime-schema",
    "allow-load-config-graph",
    "allow-list-background-assets",
    "allow-choose-background-images",
    "allow-get-background-asset-preview",
    "allow-delete-background-asset",
    "allow-open-config",
    "allow-create-config",
    "allow-stage-changes",
    "allow-apply-changes",
    "allow-list-snapshots",
    "allow-restore-snapshot"
  ]
}
